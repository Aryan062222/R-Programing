# apply()

mat <- matrix(c(1, 2, 3, 4, 5, 6), nrow = 2)

cat("Row Sum:\n")
print(apply(mat, 1, sum))

cat("\nColumn Sum:\n")
print(apply(mat, 2, sum))


# lapply()

lst <- list(a = 1:3, b = 4:6)

cat("\nlapply():\n")
print(lapply(lst, sum))


# sapply()

cat("\nsapply():\n")
print(sapply(lst, sum))


# tapply()

marks <- c(80, 90, 75, 85, 95, 70)
group <- c("A", "A", "B", "B", "A", "B")

cat("\ntapply():\n")
print(tapply(marks, group, mean))