patients <- data.frame(
  Patient_ID = c(1, 2, 3),
  Name = c("Arun", "Priya", "Rahul")
)
treatment <- data.frame(
  Patient_ID = c(1, 2, 3),
  Treatment = c("Surgery", "Medicine", "Therapy")
)
# Merge datasets
merged_data <- merge(
  patients,
  treatment,
  by = "Patient_ID"
)
print(merged_data)
customers <- data.frame(
  ID = c(1, 2, 3),
  Name = c("Arun", "Priya", "Rahul")
)
orders <- data.frame(
  ID = c(1, 2, 4),
  Amount = c(500, 700, 900)
)
# Inner join
inner <- merge(customers, orders, by = "ID")
# Left join
left <- merge(customers, orders, by = "ID", all.x = TRUE)
# Right join
right <- merge(customers, orders, by = "ID", all.y = TRUE)
# Full join
full <- merge(customers, orders, by = "ID", all = TRUE)
print(inner)
print(left)
print(right)
print(full)
